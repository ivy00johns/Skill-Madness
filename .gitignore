.claude/settings.local.json
.DS_Store
*.swp
*.swo
*~

# /skill-creator workspaces for testing and development
.workspaces/
*-workspace/

# Playwright test outputs — all ephemeral artifacts consolidate under one root
.playwright/
# Defaults Playwright/MCP write to when a project's own config is used — ignored as noise
.playwright-mcp/
playwright-report/
test-results/
# Legacy pre-consolidation dirs (kept so old runs don't show as untracked)
playwright-screenshots/
playwright-results/

# Credentials — root .env and any per-skill .env files
# .env.example is committed as the template
.env
**/.env

# Multi-tool installer build artifacts — regenerated by scripts/convert.sh on demand
integrations/

# Python bytecode cache
__pycache__/
*.pyc
