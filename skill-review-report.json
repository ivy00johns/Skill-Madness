 "issues": [
  {
   "id": "HIGH-1",
   "severity": "high",
   "skill": "(repo)",
   "dimension": "cross_skill",
   "location": "README.md:9,57,84,663 + frontmatter of 57 skills",
   "description": "README claims the library 'ports cleanly to eleven hosts' but 57/71 skills carry requires_claude_code: true, which convert.sh:664-682 skips for all 10 non-Claude-Code hosts \u2014 only 14 skills convert; all roles, both contracts, all 13 loops and the orchestrator port to zero hosts.",
   "suggestion": "Audit requires_claude_code across the 57 flagged skills (drop it where the body is host-agnostic) and rewrite README's portability claims to match the audit result."
  },
  {
   "id": "HIGH-2",
   "severity": "high",
   "skill": "(repo)",
   "dimension": "completeness",
   "location": ".github/workflows/lint-skills.yml",
   "description": "CI names 6 test dirs; tests/installer (172 tests) and tests/skill-health (17 tests) are never run \u2014 189 of 317 bats tests do not gate merges.",
   "suggestion": "Add both suites to the workflow (or run bats -r tests/) after fixing convert.sh performance (MEDIUM-2) so the job stays fast."
  },
  {
   "id": "MEDIUM-1",
   "severity": "medium",
   "skill": "(repo)",
   "dimension": "completeness",
   "location": "scripts/skill-health.sh:60; scripts/install.sh:343-382",
   "description": "skill-health telemetry is inert: the skill-usage PostToolUse hook is never merged into ~/.claude/settings.json (installer prints a paste-snippet only), so skill-events.jsonl is never written and report --json returns 0 skills; even wired, outcomes are always 'unknown'.",
   "suggestion": "Add an opt-in installer step that merges the PostToolUse entry, and print 'telemetry inactive \u2014 hook not wired' in the report when the log is absent."
  },
  {
   "id": "MEDIUM-2",
   "severity": "medium",
   "skill": "(repo)",
   "dimension": "completeness",
   "location": "scripts/convert.sh; scripts/lib/frontmatter.sh:30",
   "description": "convert.sh takes ~86s because get_field/get_array spawn a fresh python3 (importing PyYAML) per frontmatter field read, multiplied across fields x 71 skills x 11 tools; bats -r tests/ consequently takes >10 min.",
   "suggestion": "Parse each SKILL.md once into a cached structure instead of once per field."
  },
  {
   "id": "MEDIUM-3",
   "severity": "medium",
   "skill": "(repo)",
   "dimension": "completeness",
   "location": "scripts/install-plan.sh:165-166; scripts/install-apply.sh",
   "description": "Plan/apply install path writes Copilot skills only to ~/.github/agents/, never mirroring to ~/.copilot/agents/, contradicting contracts/installer/install-locations.md:17, install.sh:403-419, and lib/install-state.sh:119's own comment.",
   "suggestion": "Add the mirror write to install-apply.sh (or emit both paths in the plan)."
  },
  {
   "id": "MEDIUM-4",
   "severity": "medium",
   "skill": "(repo)",
   "dimension": "completeness",
   "location": "tests/",
   "description": "bats tests/ (non-recursive) runs zero tests and prints 1..0, which reads as green; all .bats files live in subdirectories.",
   "suggestion": "Add tests/run-all.sh (bats -r tests/) or a Makefile target and document it in scripts/README.md."
  },
  {
   "id": "MEDIUM-5",
   "severity": "medium",
   "skill": "skill-explorer",
   "dimension": "consistency",
   "location": "skills/meta/skill-explorer/SKILL.md:51; evals/evals.json:15",
   "description": "Skill-location map omits the loops category from its brace list, so enumeration from the map silently misses all 13 loop skills; the eval fixture encodes the same omission.",
